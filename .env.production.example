# AVK Envisions — production environment
#
# Copy to /opt/avkvisions/.env on the VM and fill in the marked values.
# The app refuses to start in production if a required secret is missing, so a
# typo here fails loudly at boot rather than quietly at 2am.

# ---------------------------------------------------------------------------
# Core — you MUST change these
# ---------------------------------------------------------------------------

NODE_ENV=production

# Your real domain. Used in emails, canonical URLs and Open Graph tags.
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NEXT_PUBLIC_APP_NAME="AVK Envisions"

# ABSOLUTE path, outside /opt/avkvisions. A relative path would sit inside the
# application directory, which every deploy replaces — taking the database and
# every student account with it.
DATABASE_URL="file:/var/lib/avkvisions/production.db"

# Signs session cookies. Generate a fresh one and never reuse the dev value:
#   openssl rand -base64 48
# Changing this later signs every user out; that is the intended behaviour if
# you ever suspect it has leaked.
AUTH_SECRET="CHANGE_ME_run_openssl_rand_base64_48"

SESSION_MAX_AGE_DAYS=30

# ---------------------------------------------------------------------------
# Email — read this before launch
# ---------------------------------------------------------------------------
#
# With EMAIL_PROVIDER=console, verification and password-reset emails are only
# written to the server log. Nobody receives them.
#
# So you must pick one:
#   (a) Set up Resend below and keep REQUIRE_EMAIL_VERIFICATION=true, or
#   (b) Set REQUIRE_EMAIL_VERIFICATION=false until email is configured.
#
# Leaving console + true means students can register but can never verify, and
# therefore can never start a test.

EMAIL_PROVIDER=console
EMAIL_API_KEY=""
EMAIL_FROM="AVK Envisions <no-reply@yourdomain.com>"
EMAIL_REPLY_TO="support@yourdomain.com"

REQUIRE_EMAIL_VERIFICATION=false

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
#
# With these blank, checkout is unavailable and the buy buttons say so rather
# than opening a payment window that cannot complete. Access can still be
# granted by hand from /admin/users.
#
# RAZORPAY_LIVE_MODE=true makes all three mandatory — the webhook secret
# included, because an unverified webhook lets anyone who finds the URL post
# "payment succeeded" and grant themselves the paid series.
#
# The webhook secret is NOT the API secret. Create it at
#   Razorpay Dashboard -> Settings -> Webhooks -> Add New Webhook
#   URL:    https://avkenvisions.com/api/webhooks/razorpay
#   Events: payment.captured, payment.failed
# and paste the secret you choose there into RAZORPAY_WEBHOOK_SECRET.

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_LIVE_MODE=false

INVOICE_TAX_PERCENT=18
INVOICE_SERIES_PREFIX="AVK"
INVOICE_LEGAL_NAME="AVK Envisions"
INVOICE_LEGAL_ADDRESS=""
INVOICE_GSTIN=""

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Local disk is correct for this single-VM deployment. Caddy serves these files
# directly from /var/lib/avkvisions/uploads.

STORAGE_DRIVER=local
STORAGE_MAX_UPLOAD_MB=10
NEXT_PUBLIC_STORAGE_PUBLIC_URL="https://yourdomain.com/uploads"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Rate limiting is per-process without Redis. Correct for one VM; add Redis
# only if you ever run more than one instance.
REDIS_URL=""

# AI Coach. While disabled, the page says so plainly instead of inventing
# study advice.
AI_PROVIDER=disabled
AI_API_KEY=""
AI_MODEL="claude-sonnet-5"

LOG_LEVEL=info
SENTRY_DSN=""

# Used once by `npm run db:seed` to create the first admin. Change the password
# before seeding, and change it again in the app after first sign-in.
SEED_ADMIN_EMAIL="admin@yourdomain.com"
SEED_ADMIN_PASSWORD="CHANGE_ME_before_seeding"

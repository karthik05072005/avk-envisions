# ============================================================================
# AVK VISIONS — Environment Configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Every variable is validated at boot by `src/lib/env.ts`; the app refuses to
# start in production if a required secret is missing or malformed.
# ============================================================================

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# "development" | "test" | "production"
NODE_ENV=development

# Absolute public URL of the app. Used for email links, OG tags, sitemap,
# canonical URLs and Razorpay callbacks. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public brand name shown in UI/emails when no DB setting overrides it.
NEXT_PUBLIC_APP_NAME="AVK Visions"

# ---------------------------------------------------------------------------
# Database (SQLite)
# ---------------------------------------------------------------------------
# SQLite file path, relative to the `prisma/` directory.
# To migrate to PostgreSQL later, change the datasource provider in
# prisma/schema.prisma and set a postgres:// connection string here.
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Authentication & sessions
# ---------------------------------------------------------------------------
# 32+ byte random secret. Generate: openssl rand -base64 48
AUTH_SECRET=""

# Session lifetime in days (sliding expiry).
SESSION_MAX_AGE_DAYS=30

# Set to "true" to require a verified email before students can attempt tests.
REQUIRE_EMAIL_VERIFICATION=true

# ---------------------------------------------------------------------------
# Email (transactional)
# ---------------------------------------------------------------------------
# "resend" | "console"  — "console" logs emails to stdout for local dev.
EMAIL_PROVIDER=console
EMAIL_API_KEY=""
EMAIL_FROM="AVK Visions <no-reply@avkvisions.com>"
EMAIL_REPLY_TO="support@avkvisions.com"

# ---------------------------------------------------------------------------
# Payments — Razorpay
# ---------------------------------------------------------------------------
# Key ID is exposed to the browser by design (Razorpay Checkout requires it).
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Enable to accept live payments. When false, checkout runs against test keys.
RAZORPAY_LIVE_MODE=false

# GST percentage applied to invoices (0 disables tax lines).
INVOICE_TAX_PERCENT=18
INVOICE_SERIES_PREFIX="AVK"
INVOICE_LEGAL_NAME="AVK Visions"
INVOICE_LEGAL_ADDRESS="Bengaluru, Karnataka, India"
INVOICE_GSTIN=""

# ---------------------------------------------------------------------------
# Object storage (S3 compatible: AWS S3, Cloudflare R2, MinIO)
# ---------------------------------------------------------------------------
# "s3" | "local" — "local" writes to ./storage for development only.
STORAGE_DRIVER=local
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""
# Public base URL for publicly readable assets (CDN domain).
NEXT_PUBLIC_STORAGE_PUBLIC_URL=""
# Max upload size in megabytes.
STORAGE_MAX_UPLOAD_MB=10

# ---------------------------------------------------------------------------
# Cache / rate limiting (optional — falls back to in-memory when unset)
# ---------------------------------------------------------------------------
REDIS_URL=""

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
# "anthropic" | "openai" | "disabled"
AI_PROVIDER=disabled
AI_API_KEY=""
# Model id used for question generation and the AVK AI Coach.
AI_MODEL="claude-sonnet-5"
# Optional base URL override for self-hosted / proxied gateways.
AI_BASE_URL=""
# Hard ceiling on tokens per single AI request.
AI_MAX_OUTPUT_TOKENS=4096

# ---------------------------------------------------------------------------
# Analytics & monitoring
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_KEY=""
NEXT_PUBLIC_ANALYTICS_HOST="https://app.posthog.com"
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# "debug" | "info" | "warn" | "error"
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Notifications (WhatsApp readiness — optional, off by default)
# ---------------------------------------------------------------------------
# "disabled" | "meta"
WHATSAPP_PROVIDER=disabled
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""

# ---------------------------------------------------------------------------
# Seed / bootstrap
# ---------------------------------------------------------------------------
# Credentials for the admin account created by `npm run db:seed`.
# Change these before seeding anything that is not a local dev database.
SEED_ADMIN_EMAIL="admin@avkvisions.com"
SEED_ADMIN_PASSWORD="ChangeMe!Admin2024"
